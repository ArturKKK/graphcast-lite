{
  "train_parquet": "data/postproc/corpus_v3_train.parquet",
  "val_parquet": "data/postproc/corpus_v3_val.parquet",
  "out_dir": "experiments/neural_postproc_v3",
  "feature_cols": [
    "gnn_t2m",
    "gnn_u10",
    "gnn_v10",
    "gnn_msl",
    "gnn_sp",
    "gnn_t850",
    "gnn_t500",
    "gnn_q850",
    "gnn_z500",
    "gnn_u850",
    "gnn_v850",
    "gnn_u1000",
    "gnn_v1000",
    "lapse_t850_1000",
    "dewpoint_depression",
    "solar_zen",
    "lat",
    "lon",
    "elev",
    "z_surf",
    "lsm",
    "sin_hour",
    "cos_hour",
    "sin_doy",
    "cos_doy",
    "lead_norm"
  ],
  "hidden": [
    192,
    192,
    128
  ],
  "dropout": 0.1,
  "probabilistic": false,
  "station_emb_dim": 32,
  "film_hidden": 64,
  "epochs": 40,
  "batch_size": 4096,
  "lr": 0.001,
  "weight_decay": 0.0001,
  "huber_delta": 1.0,
  "wind_alpha": 0.5,
  "w_t2m": 1.0,
  "w_wind": 1.0,
  "balanced_sampling": true,
  "num_workers": 4,
  "device": "cuda",
  "grad_clip": 1.0,
  "seed": 42
}