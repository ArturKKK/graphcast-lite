{
  "_comment": "v3 GLOBAL — wb2 512x256, 33 features (19 base + 10 new plev + 4 time-forcing). NB: 2d dewpoint NOT available in this WB2 zarr → 29 dyn instead of 30. From-scratch.",

  "batch_size": 1,
  "learning_rate": 3e-4,
  "num_epochs": 80,
  "early_stopping_patience": 15,
  "early_stopping_delta": 1e-5,
  "wandb_log": false,
  "random_seed": 42,
  "use_latitude_weighting": true,

  "max_ar_steps": 8,
  "use_residual": true,
  "roi_only_loss": false,

  "data_dir": "/data/datasets/wb2_512x256_33f_v3",

  "freeze_processor_epochs": 0,
  "finetune_processor_lr_factor": 1.0,

  "static_channels": [7, 8],
  "forcing_channels": [29, 30, 31, 32],
  "_comment_loss": "static + forcing → channel_mask=0 (lat-weighted MSE на остальных 27 каналах). noise_sigma и per-channel weights в src/train.py не реализованы — пропускаем.",

  "graph": {
    "grid2mesh_edge_creation": "radius",
    "mesh2grid_edge_creation": "contained",
    "grid2mesh_radius_query": 0.6,
    "mesh_levels": [4, 6]
  },

  "pipeline": {
    "encoder": {
      "mlp": {
        "mlp_hidden_dims": [256, 256],
        "output_dim": 256,
        "use_layer_norm": true,
        "layer_norm_mode": "node"
      },
      "gcn": {
        "layer_type": "conv_gcn",
        "hidden_dims": [256, 256],
        "output_dim": 256,
        "activation": "swish"
      }
    },
    "processor": {
      "gcn": {
        "layer_type": "interaction_net",
        "output_dim": 256,
        "activation": "swish",
        "use_layer_norm": true,
        "num_message_passing_steps": 12,
        "edge_feature_dim": 4
      }
    },
    "decoder": {
      "mlp": {
        "mlp_hidden_dims": [256, 128],
        "output_dim": 128,
        "use_layer_norm": false
      },
      "gcn": {
        "layer_type": "conv_gcn",
        "hidden_dims": [128, 128],
        "output_dim": 33,
        "activation": "swish"
      }
    }
  },

  "data": {
    "dataset_name": "wb2_512x256_33f_v3",
    "num_features_used": 33,
    "obs_window_used": 2,
    "pred_window_used": 8,
    "want_feats_flattened": true
  }
}
