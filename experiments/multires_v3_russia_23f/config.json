{
  "_comment": "v3 — Russia, 23 features (19 dynamic + 4 time-forcing) + AR8 + noise injection. See README.md.",

  "batch_size": 1,
  "learning_rate": 5e-5,
  "num_epochs": 64,
  "early_stopping_patience": 12,
  "early_stopping_delta": 1e-5,
  "wandb_log": false,
  "random_seed": 42,
  "use_latitude_weighting": true,

  "max_ar_steps": 8,
  "use_residual": true,
  "roi_only_loss": false,

  "noise_sigma": 0.05,
  "noise_apply_from_ar_step": 1,

  "data_dir": "/data/datasets/multires_russia_23f",

  "freeze_processor_epochs": 10,
  "finetune_processor_lr_factor": 0.05,

  "static_channels": [7, 8],
  "forcing_channels": [19, 20, 21, 22],

  "channel_loss_weights": {
    "0":  2.0,
    "1":  1.5,
    "2":  1.5,
    "3":  2.0,
    "4":  1.5,
    "5":  0.1,
    "6":  1.0,
    "7":  0.0,
    "8":  0.0,
    "9":  1.0,
    "10": 1.0,
    "11": 1.0,
    "12": 1.0,
    "13": 1.0,
    "14": 1.0,
    "15": 1.0,
    "16": 1.0,
    "17": 1.5,
    "18": 1.0,
    "19": 0.0,
    "20": 0.0,
    "21": 0.0,
    "22": 0.0
  },

  "graph": {
    "grid2mesh_edge_creation": "radius",
    "mesh2grid_edge_creation": "contained",
    "grid2mesh_radius_query": 0.6,
    "mesh_levels": [4, 6]
  },

  "pipeline": {
    "encoder": {
      "mlp": {
        "mlp_hidden_dims": [256, 256],
        "output_dim": 256,
        "use_layer_norm": true,
        "layer_norm_mode": "node"
      },
      "gcn": {
        "layer_type": "conv_gcn",
        "hidden_dims": [256, 256],
        "output_dim": 256,
        "activation": "swish"
      }
    },
    "processor": {
      "gcn": {
        "layer_type": "interaction_net",
        "output_dim": 256,
        "activation": "swish",
        "use_layer_norm": true,
        "num_message_passing_steps": 12,
        "edge_feature_dim": 4
      }
    },
    "decoder": {
      "mlp": {
        "mlp_hidden_dims": [256, 128],
        "output_dim": 128,
        "use_layer_norm": false
      },
      "gcn": {
        "layer_type": "conv_gcn",
        "hidden_dims": [128, 128],
        "output_dim": 23,
        "activation": "swish"
      }
    }
  },

  "data": {
    "dataset_name": "multires",
    "num_features_used": 23,
    "obs_window_used": 2,
    "pred_window_used": 8,
    "want_feats_flattened": true
  }
}
