# Тесты запускают часть скриптов подпроцессом — так проверяется не набор
# функций, а поведение всей команды целиком. Без parallel и process_start
# coverage такие запуски не видит и показывает по ним честный ноль, вводя в
# заблуждение: у add_obs_lags.py пять сквозных тестов, а в отчёте было 0 %.
[run]
parallel = true
source = src/postprocessing,scripts/postproc
